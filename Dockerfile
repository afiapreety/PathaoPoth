FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV BLOCKS_API_URL=https://blocksapi.slsblx.com
ENV BLOCKS_X_BLOCKS_KEY=Sba0c99247e2e4e4091e1bfbcc3648396

COPY --from=builder /app/dist ./dist
